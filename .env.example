# SERPENT Environment Configuration
# S.E.R.P.E.N.T. - Search Evidence & Research Platform for Exploration, Networked Thinking

# SerpApi Key (Required for live real-time web intelligence across Google, News, Scholar, Shopping, Maps)
# Get your free key at https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Optional LLM Key for advanced generative synthesis and intent analysis
# SERPENT includes built-in heuristic reasoning & fallback engines, but works with Gemini or OpenAI
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
# Comma-separated allowed frontend origins or "*"
ALLOWED_ORIGINS=*
